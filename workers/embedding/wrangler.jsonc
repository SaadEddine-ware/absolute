{
  "$schema": "https://unpkg.com/wrangler/config-schema.json",
  "name": "absolute-embedding",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "ai": {
    "binding": "AI"
  },
  "vars": {
    "EMBEDDING_MODEL": "@cf/baai/bge-base-en-v1.5"
  },
  "observability": {
    "enabled": true
  }
}